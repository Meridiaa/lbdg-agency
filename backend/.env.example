# Separate Next.js backend deployment configuration.
# Never commit the real .env.local or Vercel secret values.

NEXT_PUBLIC_SITE_URL=https://lbdg-agency.vercel.app
FRONTEND_ORIGIN=https://lbdg-agency.vercel.app

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

RESEND_API_KEY=re_YOUR_API_KEY
# Use a sender domain verified in Resend before production.
RESEND_FROM_EMAIL=LBDG Agency <website@YOUR_VERIFIED_DOMAIN>
AGENCY_NOTIFICATION_EMAIL=lbdgagency@gmail.com

# Required only for the current legacy admin prototype. Use a long random value.
# This legacy auth must be replaced with Supabase Auth before public deployment.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Google IDs belong to the agency and are configured on the frontend project.
